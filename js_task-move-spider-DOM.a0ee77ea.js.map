'use strict';
var spider = document.querySelector('.spider');
var wall = document.querySelector('.wall');
wall.addEventListener('click', function(e) {
    var rect = wall.getBoundingClientRect();
    var borderTop = wall.clientTop;
    var borderLeft = wall.clientLeft;
    var x = e.clientX - rect.left - borderLeft - spider.offsetWidth / 2;
    var y = e.clientY - rect.top - borderTop - spider.offsetHeight / 2;
    x = Math.max(0, Math.min(x, wall.clientWidth - spider.offsetWidth));
    y = Math.max(0, Math.min(y, wall.clientHeight - spider.offsetHeight));
    spider.style.left = x + 'px';
    spider.style.top = y + 'px';
});

